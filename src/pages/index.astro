---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Contact from '../components/Contact.astro';
import { getPortfolio, formatMonth, formatDay } from '../lib/content';
const { profile, projects, featured, status } = await getPortfolio();
const { basics, about, work, education } = profile;
const recent = [...status.recentActivity].filter((commit) => !/\/(my-portfolio|raditya0902|neetcode-submissions[^/]*)$/i.test(commit.repo)).sort((a, b) => b.timestamp.localeCompare(a.timestamp)).slice(0, 3);
---
<Layout>
  <section class="hero shell" aria-labelledby="hero-heading">
    <div class="hero-intro"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Software · Data · Machine Learning</p><p class="hero-location">Tempe, Arizona</p></div>
    <h1 id="hero-heading">I build systems that hold up, <br class="desktop-break" /> <span>and measure where they don’t.</span></h1>
    <div class="hero-bottom"><p class="hero-description">MS Data Science student at Arizona State University.<br class="desktop-break" /> I work across backend systems, data pipelines, and<br class="desktop-break" /> machine learning, from storage internals to evaluated AI.</p>
      <div class="hero-actions"><a class="button" href="#featured">View projects <span aria-hidden="true">↘</span></a><a class="text-link" href="#contact">Contact me <span aria-hidden="true">↗</span></a>{basics.resumeUrl && <a class="text-link" href={basics.resumeUrl}>View resume <span aria-hidden="true">↗</span></a>}</div>
    </div>
    <div class="hero-footnote"><span>Currently at ASU <span aria-hidden="true">/</span> MS expected Dec 2026</span><div class="social-links">{basics.profiles.map((profile) => <a href={profile.url}>{profile.network} <span aria-hidden="true">↗</span></a>)}</div></div>
  </section>

  <section class="shell section" id="featured" aria-labelledby="featured-heading">
    <SectionHeading number="01" title="Selected work" id="featured-heading" description="Six projects across systems, data, and applied ML. Every result comes with its measurement conditions, including the ones that went against me.">Engineering, in practice.<a slot="action" class="text-link" href="/projects">All {projects.length} projects <span aria-hidden="true">↗</span></a></SectionHeading>
    <div class="project-grid">{featured.map((project) => <ProjectCard project={project} />)}</div>
  </section>

  <section class="shell section split-section" id="about" aria-labelledby="about-heading">
    <SectionHeading number="02" title="About" id="about-heading">Curious about the<br />whole system.</SectionHeading>
    <div class="about-copy">
      <div class="prose">{about.map((paragraph) => <p>{paragraph}</p>)}</div>
      <div class="education-compact"><p class="eyebrow">Education</p><ul>{education.map((degree, index) => <li><h3>{degree.institution}</h3><p>{degree.area}</p><p class="education-meta">{formatMonth(degree.startDate)} – {index === 0 ? 'Expected ' : ''}{formatMonth(degree.endDate)} · GPA {degree.score}</p></li>)}</ul></div>
    </div>
  </section>

  <section class="shell section" id="experience" aria-labelledby="experience-heading">
    <SectionHeading number="03" title="Experience" id="experience-heading">Work beyond the repository.</SectionHeading>
    <div class="experience-list">{work.map((job) => <article class="experience-entry">
      <div class="experience-period"><span class="eyebrow">{job.kind}</span><p><time datetime={job.startDate}>{formatMonth(job.startDate)}</time> – {job.endDate ? <time datetime={job.endDate}>{formatMonth(job.endDate)}</time> : 'Present'}</p></div>
      <div>
        <h3>{job.role}</h3><p class="organization">{job.organization}</p><p>{job.summary}</p>
        {job.contributions?.length ? <ul class="contribution-list">{job.contributions.map((contribution) => <li>
          <a class="contribution-link" href={contribution.url} aria-label={`View merged ${contribution.project} pull request`}><span>{contribution.project}</span><span aria-hidden="true">↗</span></a>
          <p>{contribution.summary}</p>
        </li>)}</ul> : <ul class="bullet-list">{job.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
        <ul class="tags" aria-label="Technologies">{job.technologies.map((tech) => <li>{tech}</li>)}</ul>
        {job.links.length > 0 && <div class="entry-links">{job.links.map((link) => <a class="text-link" href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>}
      </div>
    </article>)}</div>
  </section>

  <section class="shell section activity-section" aria-labelledby="activity-heading">
    <SectionHeading number="04" title="Recent activity" id="activity-heading">From the workbench.</SectionHeading>
    <p class="activity-date">{status.lastUpdate ? <>GitHub snapshot updated <time datetime={status.lastUpdate}>{formatDay(status.lastUpdate)}</time>. Checked daily.</> : 'GitHub activity is not available yet.'}</p>
    {recent.length ? <ul class="activity-list">{recent.map((commit) => <li><a href={commit.url}><span class="commit-repo">{commit.repo.split('/')[1]}</span><span class="commit-message">{commit.kind === 'pull_request' ? 'Merged PR: ' : ''}{commit.message.split('\n')[0]}</span><time datetime={commit.timestamp}>{formatDay(commit.timestamp)}</time><span aria-hidden="true">↗</span></a></li>)}</ul> : <p class="muted">Browse my <a href="https://github.com/Raditya0902">GitHub profile</a> for the latest work.</p>}
  </section>
  <Contact basics={basics} />
</Layout>
