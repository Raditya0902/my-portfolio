---
import Layout from '../../layouts/Layout.astro';
import { getPortfolio } from '../../lib/content';
import type { DisplayProject } from '../../lib/projects';
export async function getStaticPaths() {
  const { featured } = await getPortfolio();
  return featured.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: DisplayProject }
const { project } = Astro.props;
const study = project.study;
if (!study) throw new Error(`Missing study for ${project.slug}`);
---
<Layout title={project.title} description={project.summary}>
  <article class="shell">
    <header class="page-hero"><a class="breadcrumb" href="/projects">← All projects</a><p class="eyebrow">Case study {String(project.featuredOrder).padStart(2, '0')} / {project.categories.join(' · ')}</p><h1>{project.title}<span class="accent">.</span></h1><p class="lead">{project.summary}</p>{project.kind !== 'Independent project' && <p class="project-kind">{project.kind}</p>}<ul class="tags" aria-label="Technologies">{project.technologies.map((tech) => <li>{tech}</li>)}</ul><div class="study-actions"><a class="button" href={project.githubUrl}>View repository <span aria-hidden="true">↗</span></a><a class="text-link" href="#evaluation">Jump to results ↓</a>{project.demoUrl && <a class="text-link" href={project.demoUrl}>Live demo ↗</a>}</div></header>
    <section class="study-section" aria-labelledby="problem"><h2 id="problem">The problem</h2><div class="prose"><p>{study.problem}</p></div></section>
    <section class="study-section" aria-labelledby="implementation"><h2 id="implementation">What I built</h2><div class="prose"><p>{study.built}</p></div></section>
    <section class="study-section" aria-labelledby="architecture"><h2 id="architecture">How it works</h2><div class="prose"><p>{study.architecture}</p><figure class="architecture"><ol class="flow" aria-label="System flow">{study.flow.map((step) => <li>{step}</li>)}</ol><figcaption>A simplified flow; implementation details are linked below.</figcaption></figure></div></section>
    <section class="study-section" aria-labelledby="decisions"><h2 id="decisions">Engineering decisions</h2><div>{study.decisions.map((decision) => <div class="decision"><h3>{decision.title}</h3><p class="prose">{decision.body}</p></div>)}</div></section>
    <section class="study-section" aria-labelledby="evaluation"><h2 id="evaluation">Results & evidence</h2><div><div class="results-grid">{study.results.map((result) => <div class="result"><p class="eyebrow">{result.label}</p><p class="result-value">{result.value}</p><p>{result.context}</p></div>)}</div><p class="evidence-note">Results are documented in the linked project artifacts. They have not been independently reproduced for this portfolio.</p></div></section>
    <section class="study-section" aria-labelledby="limitations"><h2 id="limitations">Limits & lessons</h2><div class="prose"><p>{study.limitations}</p><p>{study.lesson}</p></div></section>
    <section class="study-section" aria-labelledby="sources"><h2 id="sources">Source material</h2><ul class="source-list">{project.sources.map((source) => <li><a href={source.url}>{source.label} ↗</a></li>)}</ul></section>
    <div class="study-bottom"><a class="text-link" href="/projects">← Explore more projects</a></div>
  </article>
</Layout>
