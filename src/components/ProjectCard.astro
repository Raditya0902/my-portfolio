---
import type { DisplayProject } from '../lib/projects';
interface Props { project: DisplayProject; compact?: boolean }
const { project, compact = false } = Astro.props;
const href = project.study ? `/projects/${project.slug}` : project.githubUrl;
const Heading = compact ? 'h2' : 'h3';
---
<article class:list={['project-card', { compact }]} data-project data-categories={project.categories.join('|')}>
  <div class="project-meta"><span>{project.categories[0]}</span><span class="project-number" aria-hidden="true">{project.featuredOrder ? String(project.featuredOrder).padStart(2, '0') : '↗'}</span></div>
  <Heading><a href={href}>{project.title}</a></Heading>
  {project.kind !== 'Independent project' && <p class="project-kind">{project.kind}</p>}
  <p class="project-summary">{project.summary}</p>
  {!compact && <div class="engineering-note"><span class="eyebrow">Design decision</span><p>{project.decision}</p></div>}
  <p class="project-signal"><span aria-hidden="true">↳</span> {project.signal}</p>
  <ul class="tags" aria-label="Technologies">{project.technologies.map((tech) => <li>{tech}</li>)}</ul>
  <div class="project-links">
    {project.study && <a href={`/projects/${project.slug}`} aria-label={`Read case study: ${project.title}`}>Read case study <span aria-hidden="true">↗</span></a>}
    <a href={project.githubUrl} aria-label={`${project.title} on GitHub`}>GitHub <span aria-hidden="true">↗</span></a>
    {project.demoUrl && <a href={project.demoUrl}>Live demo <span aria-hidden="true">↗</span></a>}
  </div>
</article>
